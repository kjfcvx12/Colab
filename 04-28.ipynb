      "source": [
        "# 80프로는 train, 20프로는 test\n",
        "# 주가 데이터는 학습데이터와 테스트 데이터 나눌 때 shuffle하면 큰일남 => 시간 순서대로 잘라야 하니까\n",
        "train_size=int(len(features)*0.8)\n",
