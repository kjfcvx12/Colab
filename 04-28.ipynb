        "  def forward(self, x):\n",
        "    # out -> 3차원[배치, 날짜(시퀀스), 특징]\n",
        "    out,_=self.lstm(x)\n",
        "    # [모든 배치에 대해 가장 마지막의 출력값만 뽑아낸다]\n",
        "    # 데이터 전체를 다 가져와 : 20일치 날짜 중 마지막 것만 : 마지막에 들어있는 모든 정보(5개)\n",
        "    return self.fc(out[:, -1, :])"
