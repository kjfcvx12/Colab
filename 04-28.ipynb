      "execution_count": 27,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# X: 피처들(모델의 입력이 될 피처들(시가, 중가, 고가, 저가, 거래량))\n",
        "# y : 내일의 수읽률(맞춰야 하는 정답)\n",
        "# window_size=20 : 모델이 한번에 참고할 과거 데이터의 기간\n",
        "def create_seq(X,y,winodw_size=20):\n",
        "  xs, ys=[], []\n",
        "  # 전체데이터 끝-20일 뺀 지점까지만 반복\n",
        "  for i in range(len(X)-winodw_size):\n",
        "    xs.append(X[i:i+winodw_size]) # 총 20개 데이터 잘라냄\n",
        "    ys.append(y[i+winodw_size]) # 위에서 자른 20일 데이터 바로 다음 날\n",
        "  return np.array(xs), np.array(ys)"
      ],
      "metadata": {
        "id": "vPvUDNurI3lL"
      },
      "execution_count": 28,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "X_train, y_train=create_seq(X_train_scaled,y_train,20)\n",
        "X_test, y_test=create_seq(X_test_scaled,y_test,20)"
      ],
      "metadata": {
        "id": "jxfpS657I4bb"
      },
      "execution_count": 29,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# X_train.shape : (전체 샘플수, window_size, feature수)\n",
        "print(X_train.shape, y_train.shape, X_test.shape, y_test.shape)"
      ],
